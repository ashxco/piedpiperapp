# Pied Piper runs locally without cloud credentials.
# Optional: configure your own Pied Piper Connect infrastructure.
# PIEDPIPER_CLERK_PUBLISHABLE_KEY=
# PIEDPIPER_CLERK_JWT_TEMPLATE=piedpiperapp-relay
# PIEDPIPER_CLERK_CLI_OAUTH_CLIENT_ID=
# PIEDPIPER_RELAY_URL=https://relay.piedpiperapp.com
# PIEDPIPER_HOSTED_APP_URL=https://app.piedpiperapp.com
