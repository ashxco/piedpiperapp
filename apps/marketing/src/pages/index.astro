---
import Layout from "../layouts/Layout.astro";
import { GITHUB_REPOSITORY_URL } from "../lib/site";
---
<Layout title="Pied Piper — Your agents. Your workspace." description="A local-first, open-source workspace for coding agents. No product analytics or telemetry exports.">
  <section class="container" style="padding-block: 100px; max-width: 1000px">
    <p class="eyebrow">OPEN SOURCE · LOCAL FIRST</p>
    <h1 class="display" style="font-size: clamp(48px, 8vw, 100px); line-height: 1; margin-block: 28px">Your agents.<br />Your workspace.</h1>
    <p style="max-width: 640px; font-size: 21px; line-height: 1.6">Pied Piper brings your coding agents into one workspace. Connect your existing providers, work across projects, and keep control of your data.</p>
    <div style="display: flex; gap: 16px; flex-wrap: wrap; margin-top: 36px">
      <a class="btn btn-primary btn-lg" href="/download">Build locally</a>
      <a class="btn btn-lg" href={GITHUB_REPOSITORY_URL}>Explore the source</a>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 32px; margin-top: 90px">
      <article><h2>One place to work</h2><p>Use Codex, Claude Code, Cursor, OpenCode, and other supported agents with your own accounts.</p></article>
      <article><h2>No telemetry</h2><p>No product analytics, identity tracking, or diagnostic exports. Operational logs stay on your machine.</p></article>
      <article><h2>Yours to change</h2><p>Read the code, run it locally, and shape it to your workflow. Released under the MIT license.</p></article>
    </div>
  </section>
</Layout>
